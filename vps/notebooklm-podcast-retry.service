[Unit]
Description=KANRI Audio: ritenta la pubblicazione della puntata (coda archive.org satura)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/notebooklm
EnvironmentFile=/opt/notebooklm/notebooklm.env
Environment=PATH=/opt/notebooklm/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# ritento silenzioso: l'avviso email è già partito col run principale
Environment=PODCAST_QUIET=1
ExecStart=/opt/notebooklm/.venv/bin/python /opt/notebooklm/kanri_podcast.py
