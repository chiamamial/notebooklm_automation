[Unit]
Description=Ritenta nel pomeriggio del lunedì la pubblicazione della puntata KANRI

[Timer]
# La coda di archive.org può restare satura per ore, a volte per un giorno
# intero: se il run delle 12:00 non ce l'ha fatta si riprova fino a mercoledì.
# Questi run costano nulla quando non c'è nulla in sospeso (escono subito) e
# riprendono sempre la puntata di lunedì, mai una nuova (PODCAST_RESUME=1).
OnCalendar=Mon *-*-* 14,16,18,20,22:00:00
OnCalendar=Tue,Wed *-*-* 08,12,16,20:00:00
# niente recuperi al riavvio: i ritenti hanno senso solo a ridosso della puntata
Persistent=false

[Install]
WantedBy=timers.target
